generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceProfile {
  INDIVIDUAL
  FAMILY
  BUSINESS
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum SubscriptionState {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DevicePairingState {
  UNPAIRED
  PAIRING_PENDING
  PAIRED
  REVOKED
}

enum ActivationCodeStatus {
  ISSUED
  CONSUMED
  EXPIRED
}

enum PairingStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Workspace {
  workspaceId String @id @default(uuid()) @db.Uuid
  name String
  profile WorkspaceProfile
  status WorkspaceStatus @default(ACTIVE)
  memberships Membership[]
  sessions Session[]
  subscription Subscription?
  activationCodes ActivationCode[]
  devices Device[]
  pairings Pairing[]
  deviceSessions DeviceSession[]
  events Event[]
  commands Command[]
  policy Policy?
  locationSamples LocationSample[]
  geofences Geofence[]
  geofenceStates GeofenceState[]
}

// Global identity, as defined by doc 21; authentication lives in the auth module.
model User {
  userId String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String?
  status UserStatus @default(ACTIVE)
  memberships Membership[]
  sessions Session[]
}

model Membership {
  workspaceId String @db.Uuid
  userId String @db.Uuid
  role MembershipRole
  status MembershipStatus @default(ACTIVE)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([userId])
}

// Human account session. Only opaque token HASHES are stored; raw tokens never persist.
model Session {
  sessionId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  userId String @db.Uuid
  accessTokenHash String @unique
  refreshTokenHash String @unique
  accessExpiresAt DateTime
  refreshExpiresAt DateTime
  status SessionStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([userId])
  @@index([workspaceId])
}

// Commercial plan; limits/trial are configurable data (ADR-0011).
model Plan {
  planId String @id @default(uuid()) @db.Uuid
  name String
  profile WorkspaceProfile
  deviceLimit Int
  trialDurationHours Int
  active Boolean @default(true)
  subscriptions Subscription[]
}

model Subscription {
  subscriptionId String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid
  planId String @db.Uuid
  state SubscriptionState @default(TRIAL)
  trialStartedAt DateTime
  trialExpiresAt DateTime
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [planId], onDelete: Restrict)
}

// Single-use activation authorization issued to a workspace. Only code/ticket HASHES persist.
model ActivationCode {
  activationCodeId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  codeHash String @unique
  status ActivationCodeStatus @default(ISSUED)
  boundDeviceId String? @db.Uuid
  ticketHash String? @unique
  ticketExpiresAt DateTime?
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)

  @@index([workspaceId])
}

// Device identity in a workspace. deviceId is the client-supplied installation UUID.
model Device {
  deviceId String @id @db.Uuid
  workspaceId String @db.Uuid
  name String
  manufacturer String
  model String
  androidVersion String
  appVersion String
  pairingState DevicePairingState @default(UNPAIRED)
  lastSyncAt DateTime?
  batteryLevel Int?
  networkType String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  sessions DeviceSession[]
  pairings Pairing[]
  commands Command[]
  locationSamples LocationSample[]
  geofenceStates GeofenceState[]

  @@index([workspaceId])
}

// Pending pairing transaction; pairing ticket stored as HASH with short expiry.
model Pairing {
  pairingId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  deviceId String @db.Uuid
  status PairingStatus @default(PENDING)
  ticketHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)

  @@index([deviceId])
  @@index([workspaceId])
}

// Device session, separate from account and FCM. Only token HASHES persist; refresh rotates.
model DeviceSession {
  sessionId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  deviceId String @db.Uuid
  accessTokenHash String @unique
  refreshTokenHash String @unique
  accessExpiresAt DateTime
  refreshExpiresAt DateTime
  status SessionStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)

  @@index([deviceId])
  @@index([workspaceId])
}

enum EventCategory {
  DEVICE
  ENROLLMENT
  COMMAND
  SECURITY
  LOCATION
}

enum EventSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum CommandType {
  REQUEST_CHECKIN
  SYNC_NOW
  SHOW_MESSAGE
  RING_DEVICE
  REFRESH_DEVICE_INFO
}

enum CommandStatus {
  QUEUED
  DELIVERED
  EXECUTED
  FAILED
  EXPIRED
  CANCELLED
}

// Append-only timeline entry. No private content in payload (doc 14).
model Event {
  eventId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  deviceId String? @db.Uuid
  category EventCategory
  type String
  severity EventSeverity @default(INFO)
  source String
  payload Json?
  occurredAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)

  @@index([workspaceId, deviceId, occurredAt])
}

// Server->device command with a closed catalog, idempotent lifecycle and expiry (doc 15).
model Command {
  commandId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  deviceId String @db.Uuid
  type CommandType
  payload Json?
  status CommandStatus @default(QUEUED)
  requestedBy String? @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime
  deliveredAt DateTime?
  executedAt DateTime?
  result String?
  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)

  @@index([deviceId, status])
  @@index([workspaceId])
}

// Per-workspace compliance policy; thresholds are configurable data (ADR-0011).
model Policy {
  policyId String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid
  minAppVersion String @default("0.0.0")
  maxOfflineHours Int @default(24)
  riskWeightNotPaired Int @default(40)
  riskWeightOfflineTooLong Int @default(25)
  riskWeightAgentOutdated Int @default(15)
  riskWeightNeverSeen Int @default(10)
  riskWeightRevoked Int @default(50)
  // Location is sensitive data: retention is short and configurable per tenant (LGPD, doc 16).
  locationRetentionDays Int @default(30)
  locationStaleMinutes Int @default(30)
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
}

enum LocationSource {
  GPS
  FUSED
  NETWORK
}

enum GeofenceTransition {
  ENTER
  EXIT
  DWELL
}

// A consented position report. observedAt is the device clock (informative);
// serverReceivedAt is the authority (ADR-0004). Staleness is derived, never stored.
model LocationSample {
  locationSampleId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  deviceId String @db.Uuid
  latitude Float
  longitude Float
  accuracyMeters Float
  source LocationSource
  observedAt DateTime
  serverReceivedAt DateTime @default(now())
  consentVersion String
  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)

  @@index([workspaceId, deviceId, serverReceivedAt])
}

// Circular geofence (doc 16 §3b: circles in the MVP, no polygons/PostGIS).
model Geofence {
  geofenceId String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  name String
  centerLatitude Float
  centerLongitude Float
  radiusMeters Int
  transitions GeofenceTransition[]
  dwellMinutes Int @default(10)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  states GeofenceState[]

  @@index([workspaceId])
}

// Last known containment of a device in a geofence; lets the server derive ENTER/EXIT/DWELL.
model GeofenceState {
  geofenceId String @db.Uuid
  deviceId String @db.Uuid
  workspaceId String @db.Uuid
  inside Boolean
  since DateTime
  dwellNotifiedAt DateTime?
  updatedAt DateTime @updatedAt
  geofence Geofence @relation(fields: [geofenceId], references: [geofenceId], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)

  @@id([geofenceId, deviceId])
  @@index([workspaceId, deviceId])
}
