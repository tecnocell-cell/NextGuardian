{
  "name": "@nexguardian/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "test:integration": "node scripts/test-postgres.mjs",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "pretest": "npm run db:generate",
    "pretest:integration": "npm run db:generate"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "type": "module",
  "overrides": {
    "multer": "2.3.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
